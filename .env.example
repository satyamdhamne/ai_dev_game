# Where the waitlist form POSTs (Formspree, Tally, Google Forms, your own endpoint...).
# The form sends multipart form data: an email field plus "source".
NEXT_PUBLIC_WAITLIST_URL=

# Optional: name of the email field the endpoint expects. Defaults to "email".
# Google Forms example: entry.1234567890
NEXT_PUBLIC_WAITLIST_EMAIL_FIELD=

# Optional: canonical URL used for Open Graph / metadata. Defaults to https://spottheaibug.com
NEXT_PUBLIC_SITE_URL=
